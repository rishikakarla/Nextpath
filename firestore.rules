rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Content (coding problems, assessment, roadmap, daily tasks, aptitude topics)
    // Any logged-in user can read; admin or registered trainers can write
    match /content/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (request.auth.token.email == 'kakarlarishi5124@gmail.com'
                       || exists(/databases/$(database)/documents/trainers/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--'))));
    }

    // Trainers — any logged-in user can read (for role detection on login)
    // Only admin can create / delete trainer entries
    match /trainers/{trainerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'kakarlarishi5124@gmail.com';
    }

    // Users — own doc: full access; any authenticated user can read (needed for mentor portal)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Leaderboard — all logged-in users can read; each user writes only their own entry
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Daily Leaderboard — all logged-in users can read; each user writes only their own entry
    match /dailyLeaderboard/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // Mentors — any logged-in user can read (for role detection on login)
    // Only admin can create / delete mentor entries
    match /mentors/{mentorId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'kakarlarishi5124@gmail.com';
    }

    // Feedback — any authenticated user can read (mentors need to read all students' feedback)
    // Students see only their own feedback (enforced at app level in MentorFeedback page)
    match /feedback/{studentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Colleges — any logged-in user can read (needed for the registration dropdown).
    // Only admin can create/delete a college. Admin or that college's own college-admin
    // can update it (e.g. editing departments/academicYears).
    match /colleges/{collegeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.token.email == 'kakarlarishi5124@gmail.com';
      allow update: if request.auth != null
                    && (request.auth.token.email == 'kakarlarishi5124@gmail.com'
                        || (exists(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--')))
                            && get(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--'))).data.collegeId == collegeId));
      allow delete: if request.auth != null
                    && request.auth.token.email == 'kakarlarishi5124@gmail.com';
    }

    // College Admins — any logged-in user can read (for role detection on login).
    // Only admin can create/delete college-admin entries.
    match /collegeAdmins/{adminId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'kakarlarishi5124@gmail.com';
    }

    // Assessment Modules — readable by admin, by users in the same college, or by that
    // college's own college-admin. Writable only by admin or that college's college-admin.
    match /assessmentModules/{moduleId} {
      allow read: if request.auth != null
                  && (request.auth.token.email == 'kakarlarishi5124@gmail.com'
                      || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profile.collegeId == resource.data.collegeId
                      || ('targetEmails' in resource.data && resource.data.targetEmails.hasAny([request.auth.token.email]))
                      || (exists(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--')))
                          && get(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--'))).data.collegeId == resource.data.collegeId));
      allow create, update: if request.auth != null
                  && (request.auth.token.email == 'kakarlarishi5124@gmail.com'
                      || (exists(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--')))
                          && get(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--'))).data.collegeId == request.resource.data.collegeId));
      allow delete: if request.auth != null
                  && (request.auth.token.email == 'kakarlarishi5124@gmail.com'
                      || (exists(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--')))
                          && get(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--'))).data.collegeId == resource.data.collegeId));
    }

    // College Students — a roster of students (name, email, regNo, academicYear) that a
    // college admin maintains to target Assessment Modules. Only that college's own
    // college-admin (or the global admin) can read/write it — not readable by students.
    match /collegeStudents/{studentId} {
      allow read: if request.auth != null
                  && (request.auth.token.email == 'kakarlarishi5124@gmail.com'
                      || (exists(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--')))
                          && get(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--'))).data.collegeId == resource.data.collegeId));
      allow create: if request.auth != null
                  && (request.auth.token.email == 'kakarlarishi5124@gmail.com'
                      || (exists(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--')))
                          && get(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--'))).data.collegeId == request.resource.data.collegeId));
      allow update, delete: if request.auth != null
                  && (request.auth.token.email == 'kakarlarishi5124@gmail.com'
                      || (exists(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--')))
                          && get(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--'))).data.collegeId == resource.data.collegeId));
    }

    // Student Groups — named, reusable sets of student emails (e.g. a cohort/batch or an
    // ad-hoc group) that a college admin builds to quickly target Assessment Modules.
    // Same scoping as College Students — only that college's admin (or the global admin).
    match /studentGroups/{groupId} {
      allow read: if request.auth != null
                  && (request.auth.token.email == 'kakarlarishi5124@gmail.com'
                      || (exists(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--')))
                          && get(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--'))).data.collegeId == resource.data.collegeId));
      allow create: if request.auth != null
                  && (request.auth.token.email == 'kakarlarishi5124@gmail.com'
                      || (exists(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--')))
                          && get(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--'))).data.collegeId == request.resource.data.collegeId));
      allow update, delete: if request.auth != null
                  && (request.auth.token.email == 'kakarlarishi5124@gmail.com'
                      || (exists(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--')))
                          && get(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--'))).data.collegeId == resource.data.collegeId));
    }

    // Module Submissions — a student can read/write only their own submission.
    // That submission's college admin (or global admin) can read all of them for results.
    match /moduleSubmissions/{subId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.uid
                      || request.auth.token.email == 'kakarlarishi5124@gmail.com'
                      || (exists(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--')))
                          && get(/databases/$(database)/documents/collegeAdmins/$(request.auth.token.email.replace('\\.', '__').replace('@', '--at--'))).data.collegeId == resource.data.collegeId));
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow delete: if false;
    }
  }
}
